{
  "name": "@okeeffed/postman-tools",
  "description": "Helper tools to generate Postman collections and environments",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.cts",
  "author": "Dennis O'Keeffe",
  "license": "CC-BY-NC-4.0",
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.cts",
    "dist/**/*.d.mts"
  ],
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "postman-tools": "dist/main.cjs"
  },
  "scripts": {
    "dev": "npx tsx src/main.ts",
    "build": "tsdown",
    "build:publish": "npm run build && npm publish --access public",
    "test": "jest",
    "seed": "tsx seed.ts",
    "bootstrap": "bin/bootstrap.sh",
    "postman-schema": "tsx bin/postman-json-schema.ts",
    "type-check": "tsgo"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@tsconfig/node20": "^20.1.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/openapi-to-postmanv2": "^5.0.0",
    "@types/prompts": "^2.4.9",
    "@typescript/native-preview": "^7.0.0-dev.20251125.1",
    "jest": "30.2.0",
    "ts-jest": "^29.4.5",
    "tsdown": "^0.16.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@tsconfig/node24": "^24.0.3",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "cosmiconfig": "^9.0.0",
    "cosmiconfig-typescript-loader": "^6.2.0",
    "es-toolkit": "^1.42.0",
    "json-refs": "^3.0.15",
    "json-schema-to-zod": "^2.7.0",
    "openapi-to-postmanv2": "^5.5.0",
    "oxfmt": "^0.15.0",
    "oxlint": "^1.30.0",
    "prompts": "^2.4.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "overrides": {
    "js-yaml": "^4.1.1"
  }
}
